        "id": { "type": "string" },
        "name": { "type": "string" },
        "mark": { "type": "string" },
        "level": { "type": "string" },
        "start": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "type": { "type": "string" },
        "width": { "type": "number" },
        "depth": { "type": "number", "description": "Height of the section." },
        "top_offset": { "type": "number", "default": 0.0 },
        "material": { "type": "string" }
      },
      "required": ["id", "level", "start", "end"],
      "additionalProperties": false
    },
    "Stair": {
      "type": "object",
      "description": "A stair: one flight, or two with a landing between.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "start": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "The middle of the first riser, in plan."
        },
        "direction": {
          "type": "number",
          "description": "Which way the first flight climbs, degrees anticlockwise from x.",
          "default": 0.0
        },
        "width": { "type": "number" },
        "max_riser": {
          "type": "number",
          "description": "The tallest riser allowed; the risers share the height equally.",
          "default": 0.18
        },
        "tread": {
          "type": "number",
          "description": "The depth of each tread.",
          "default": 0.28
        },
        "height": {
          "type": "number",
          "description": "A fixed rise. Left out: up to the next level."
        },
        "base_offset": { "type": "number", "default": 0.0 },
        "waist": {
          "type": "number",
          "description": "Thickness of the sloping slab under the steps.",
          "default": 0.15
        },
        "landing": { "$ref": "#/$defs/Landing" },
        "material": { "type": "string" }
      },
      "required": ["id", "level", "start", "width"],
      "additionalProperties": false
    },
    "Landing": {
      "type": "object",
      "description": "A landing that turns a stair.",
      "properties": {
        "after": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of risers before it."
        },
        "turn": { "$ref": "#/$defs/Side" }
      },
      "required": ["after", "turn"],
      "additionalProperties": false
    },
    "Side": {
      "type": "string",
      "description": "Left or right.",
      "enum": ["left", "right"]
    },
    "Railing": {
      "type": "object",
      "description": "A railing along a path, or along one side of a stair.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "path": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "description": "Points of its path, heights above the level. Not used when it follows a stair."
        },
        "height": { "type": "number", "default": 1.0 },
        "post_spacing": { "type": "number", "default": 1.0 },
        "stair": {
          "type": "string",
          "description": "A stair's id: the railing follows its `side`."
        },
        "side": { "$ref": "#/$defs/Side" },
        "material": { "type": "string" }
      },
      "required": ["id", "level"],
      "additionalProperties": false
    },
    "Part": {
      "type": "object",
      "description": "An extrusion of a plan outline, or a sweep of a profile along a path. A void cuts what it meets (a firebox in a chimney, a hole through a slab) instead of being solid.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "outline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "An extrusion's outline in plan."
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "description": "An extrusion's holes."
        },
        "base": {
          "type": "number",
          "description": "An extrusion's bottom above the level.",
          "default": 0.0
        },
        "height": { "type": "number", "description": "An extrusion's height." },
        "plane": {
          "$ref": "#/$defs/Plane",
          "description": "An extrusion drawn on a face: its outline lies on this plane, and `base` and `height` run along the plane's normal (`x` × `y`)."
        },
        "profile": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "A sweep's section: `x` across the path (positive to its left), `y` up from it."
        },
        "path": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "description": "A sweep's path through points, `z` above the level."
        },
        "closed": {
          "type": "boolean",
          "description": "The path runs from its last point back to its first.",
          "default": false
        },
        "face_normal": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "A path drawn on a face: the face's outward normal, which the profile's `y` runs along instead of up."
        },
        "wall": {
          "type": "string",
          "description": "A sweep along a wall's id, at its top or base: it follows the wall (a coping, a plinth)."
        },
        "edge": { "$ref": "#/$defs/WallEdge", "default": "top" },
        "offset": {
          "type": "number",
          "description": "Lifts a wall path off its edge.",
          "default": 0.0
        },
        "extend": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "Runs a wall path on past the wall's start and end."
        },
        "void": { "type": "boolean", "default": false },
        "material": { "type": "string" },
        "ifc_class": { "type": "string", "description": "The IFC class it exports as." }
      },
      "required": ["id", "level"],
      "additionalProperties": false
    },
    "Plane": {
      "type": "object",
      "description": "A plane anywhere in the model: its origin (height above the level) and two square unit axes along it.",
      "properties": {
        "origin": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "x": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "y": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["origin", "x", "y"],
      "additionalProperties": false
    },
    "WallEdge": {
      "type": "string",
      "description": "A wall's top or base.",
      "enum": ["top", "base"]
    },
    "SiteElement": {
      "type": "object",
      "description": "A site element: terrain, a hard landscape area or a plant.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/SiteKind" },
        "level": { "type": "string" },
        "outline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Terrain and area: the outline."
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "description": "An area's holes."
        },
        "top": {
          "type": "number",
          "description": "Terrain and area: the top above the level.",
          "default": 0.0
        },
        "thickness": { "type": "number", "description": "Terrain and area: how deep." },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "description": "Terrain: spot heights `[x, y, z]`, `z` above the level."
        },
        "contour": {
          "type": "number",
          "description": "Terrain: a contour every so much height; 0 draws none.",
          "default": 0.0
        },
        "pattern": {
          "$ref": "#/$defs/SitePattern",
          "description": "An area's surface pattern."
        },
        "at": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "A plant's position."
        },
        "base": {
          "type": "number",
          "description": "A plant's base above the level.",
          "default": 0.0
        },
        "plant": { "$ref": "#/$defs/PlantForm", "default": "tree" },
        "canopy": { "type": "number", "description": "A plant's crown across." },
        "height": { "type": "number", "description": "A plant's height." },
        "material": { "type": "string" }
      },
      "required": ["id", "kind", "level"],
      "additionalProperties": false
    },
    "SiteKind": {
      "type": "string",
      "description": "What a site element is.",
      "enum": ["terrain", "area", "plant"]
    },
    "SitePattern": {
      "type": "object",
      "description": "An area's surface: units (`size`, `stagger`, `angle`), lines (`spacing`, `angle`) or stipple (`spacing`).",
      "properties": {
        "kind": { "$ref": "#/$defs/PatternKind" },
        "size": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "stagger": { "type": "boolean", "default": false },
        "angle": { "type": "number", "default": 0.0 },
        "spacing": { "type": "number" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "PatternKind": {
      "type": "string",
      "description": "A surface pattern.",
      "enum": ["none", "units", "lines", "stipple"]
    },
    "PlantForm": {
      "type": "string",
      "description": "A plant's form.",
      "enum": ["tree", "conifer", "palm", "shrub"]
    },
    "Object": {
      "type": "object",
      "description": "Furniture or a fixture from CreaBIM's catalogue.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mark": { "type": "string" },
        "level": { "type": "string" },
        "catalogue": {
          "type": "string",
          "description": "The catalogue object's key: \"starter/sofa-3\" (`creabim catalogue` lists them; \"starter/\" may be left out)."
        },
        "at": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "Where it goes in plan: its origin (the middle of its back edge), or its middle with `anchor` \"centre\"."
        },
        "anchor": { "$ref": "#/$defs/Anchor", "default": "origin" },
        "rotation": {
          "type": "number",
          "description": "Turn, degrees anticlockwise. At 0 its back is towards +y.",
          "default": 0.0
        },
        "offset": {
          "type": "number",
          "description": "Its floor above the level (for one hung from the ceiling, its top below the ceiling). Left out: the catalogue's."
        }
      },
      "required": ["id", "level", "catalogue", "at"],
      "additionalProperties": false
    },
    "Anchor": {
      "type": "string",
      "description": "Which point of an object `at` gives.",
      "enum": ["origin", "centre"]
    },
    "Room": {
      "type": "object",
      "description": "A room: the space the walls close off round `at`, or an outline drawn for it.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "number": { "type": "string", "default": "" },
        "level": { "type": "string" },
        "at": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "A point inside it, where its tag sits."
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "An outline of its own; left out, the walls round `at` bound it."
        },
        "height": {
          "type": "number",
          "description": "Its top above its level. Left out: to the ceiling, or the level's height."
        },
        "floor_finish": { "type": "string", "default": "" },
        "wall_finish": { "type": "string", "default": "" },
        "ceiling_finish": { "type": "string", "default": "" },
        "occupancy": { "type": "string", "default": "" },
        "department": { "type": "string", "default": "" }
      },
      "required": ["id", "level", "at"],
      "additionalProperties": false
    },
    "View": {
      "type": "object",
      "description": "A view: a plan of a level, a section or elevation along a line, a 3D view, or a schedule. Which fields it uses depends on its `kind`: plan: `level`, `cut_height`, `ceiling_plan`; section and elevation: `start`, `end`, `depth`; 3d: `azimuth`, `altitude`; schedule: `category`, `by_type`.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Its title; the id when left out." },
        "kind": { "$ref": "#/$defs/ViewKind" },
        "scale": {
          "type": "number",
          "description": "The scale's denominator: 100 is 1:100.",
          "default": 100.0
        },
        "style": {
          "$ref": "#/$defs/ViewStyle",
          "description": "Left out: shaded for 3D views, hidden line for the rest."
        },
        "level": { "type": "string", "description": "A plan's level." },
        "cut_height": {
          "type": "number",
          "description": "A plan's cut above its level.",
          "default": 1.2
        },
        "ceiling_plan": {
          "type": "boolean",
          "description": "A reflected ceiling plan.",
          "default": false
        },
        "room_colours": {
          "type": "boolean",
          "description": "Each room washed in a colour of its own.",
          "default": false
        },
        "start": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "A section or elevation's line. It looks to the left of start → end: a line drawn west to east looks north."
        },
        "end": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "depth": { "type": "number", "description": "How far a section or elevation looks." },
        "azimuth": {
          "type": "number",
          "description": "A 3D view's compass bearing: 0 from the south, anticlockwise.",
          "default": 30.0
        },
        "altitude": {
          "type": "number",
          "description": "A 3D view's angle above the horizon.",
          "default": 30.0
        },
        "category": {
          "$ref": "#/$defs/ScheduleCategory",
          "description": "What a schedule lists."
        },
        "by_type": {
          "type": "boolean",
          "description": "A schedule's rows grouped by type.",
          "default": false
        },
        "callout": {
          "$ref": "#/$defs/Callout",
          "description": "Makes it a callout of another view: an enlarged part of it. Give it the same kind and line (or level) as its parent."
        }
      },
      "required": ["id", "kind"],
      "additionalProperties": false
    },
    "ViewKind": {
      "type": "string",
      "description": "What a view is.",
      "enum": ["plan", "section", "elevation", "3d", "schedule"]
    },
    "ViewStyle": {
      "type": "string",
      "description": "How a view draws.",
      "enum": ["hidden-line", "shaded", "wireframe"]
    },
    "ScheduleCategory": {
      "type": "string",
      "description": "What a schedule lists.",
      "enum": [
        "doors",
        "windows",
        "walls",
        "slabs",
        "structure",
        "furniture",
        "fixtures",
        "rooms",
        "materials"
      ]
    },
    "Callout": {
      "type": "object",
      "description": "The box of a parent view a callout enlarges, in that view's drawing coordinates.",
      "properties": {
        "parent": { "type": "string", "description": "The parent view's id." },
        "min": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "max": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["parent", "min", "max"],
      "additionalProperties": false
    },
    "Sheet": {
      "type": "object",
      "description": "A drawing sheet, with views placed on it. Its id is its number.",
      "properties": {
        "id": { "type": "string", "description": "Its number: \"A101\"." },
        "name": { "type": "string", "description": "Its title; the number when left out." },
        "size": {
          "$ref": "#/$defs/PaperSize",
          "description": "An ISO paper size, landscape. Give this or `width` and `height`."
        },
        "width": { "type": "number", "description": "In millimetres." },
        "height": { "type": "number" },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Title block fields by name."
        },
        "viewports": {
          "type": "array",
          "items": { "$ref": "#/$defs/Viewport" }
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "PaperSize": {
      "type": "string",
      "description": "ISO paper sizes, landscape.",
      "enum": ["A0", "A1", "A2", "A3", "A4"]
    },
    "Viewport": {
      "type": "object",
      "description": "A view placed on a sheet.",
      "properties": {
        "view": { "type": "string", "description": "A view's id." },
        "at": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "Where on the sheet, in millimetres from its lower left corner."
        },
        "target": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "The drawing point (in the file's units, as the drawing's x and y) put at `at`. Left out: the middle of the crop, or of the whole drawing."
        },
        "crop": {
          "$ref": "#/$defs/Rect",
          "description": "Only this part of the drawing is shown (drawing coordinates)."
        }
      },
      "required": ["view", "at"],
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "description": "A tag in a view, showing an element's mark (a door's, a window's) or a room's name, number and area. It moves with its element.",
      "properties": {
        "view": { "type": "string", "description": "A view's id." },
        "element": { "type": "string", "description": "The id of the element it tags." },
        "offset": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "Where it sits, from the element's middle, in drawing units.",
          "default": [0.0, 0.0]
        },
        "elbow": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "A bend in its leader, from the element's middle."
        },
        "end": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "Where its leader ends, from the element's middle; left out, at the middle."
        }
      },
      "required": ["view", "element"],
      "additionalProperties": false
    },
    "Note": {
      "type": "object",
      "description": "Text in a view (drawing coordinates, in the file's units) or on a sheet (paper millimetres).",
      "properties": {
        "view": { "type": "string", "description": "A view's id, or a sheet's." },
        "at": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "Where its first line starts: its left end, mid-height."
        },
        "text": { "type": "string", "description": "Line breaks (`\\n`) start new lines." },
        "leader": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "A leader from the text to this point, in the same units as `at`."
        },
        "elbow": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "A bend in the leader."
        },
        "colour": {
          "oneOf": [
            { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0, "maximum": 1 },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      },
      "required": ["view", "at", "text"],
      "additionalProperties": false
    }
  }
}
