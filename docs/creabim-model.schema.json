{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kingbenoitbrice-fun/CreaBIM/blob/main/docs/creabim-model.schema.json",
  "title": "CreaBIM model",
  "description": "A CreaBIM model described in JSON, format version 1. Lengths are in metres unless `units` says otherwise. See docs/json-format.md.",
  "$ref": "#/$defs/Model",
  "$defs": {
    "Model": {
      "type": "object",
      "description": "A whole model: the file's top level. Every list may be left out. Ids are chosen by you, are unique across the whole file, and are what elements use to refer to each other (a door names its wall's id, a plan names its level's id).",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Where an editor finds this schema; ignored by CreaBIM."
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "description": "The format version the file is written to. This CreaBIM reads 1."
        },
        "units": {
          "$ref": "#/$defs/LengthIn",
          "description": "The unit every length in the file is in, except the sizes and positions on sheets, which are always paper millimetres. Angles are always degrees.",
          "default": "m"
        },
        "display_units": {
          "$ref": "#/$defs/DisplayUnits",
          "description": "How the project shows and takes lengths (the model is metres whatever this says)."
        },
        "materials": {
          "type": "array",
          "items": { "$ref": "#/$defs/Material" }
        },
        "assemblies": {
          "type": "array",
          "items": { "$ref": "#/$defs/Assembly" },
          "description": "Layered build-ups for walls, floors and roofs."
        },
        "types": {
          "type": "array",
          "items": { "$ref": "#/$defs/Type" },
          "description": "Element types: wall types, door and window types, slab, roof, column and beam types."
        },
        "levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/Level" }
        },
        "grid_groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridGroup" }
        },
        "grids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Grid" }
        },
        "walls": {
          "type": "array",
          "items": { "$ref": "#/$defs/Wall" }
        },
        "openings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Opening" },
          "description": "Doors, windows and bare holes, each in a wall."
        },
        "slabs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Slab" }
        },
        "roofs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Roof" }
        },
        "columns": {
          "type": "array",
          "items": { "$ref": "#/$defs/Column" }
        },
        "beams": {
          "type": "array",
          "items": { "$ref": "#/$defs/Beam" }
        },
        "stairs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Stair" }
        },
        "railings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Railing" }
        },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Part" },
          "description": "Extrusions and sweeps, solid or voids that cut what they meet."
        },
        "site": {
          "type": "array",
          "items": { "$ref": "#/$defs/SiteElement" },
          "description": "Terrain, hard landscape and planting."
        },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Object" },
          "description": "Furniture and fixtures from the catalogue."
        },
        "rooms": {
          "type": "array",
          "items": { "$ref": "#/$defs/Room" }
        },
        "views": {
          "type": "array",
          "items": { "$ref": "#/$defs/View" }
        },
        "sheets": {
          "type": "array",
          "items": { "$ref": "#/$defs/Sheet" }
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/Tag" },
          "description": "Tags of doors, windows, rooms and other elements, in views."
        },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Note" },
          "description": "Text written in a view or on a sheet."
        }
      },
      "required": ["version"],
      "additionalProperties": false
    },
    "LengthIn": {
      "type": "string",
      "description": "A unit lengths are written in.",
      "enum": ["m", "mm", "cm", "ft", "in"]
    },
    "DisplayUnits": {
      "type": "object",
      "description": "The project's display units.",
      "properties": {
        "length": { "$ref": "#/$defs/DisplayLength" },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "description": "Decimal places; for feet and inches, the smallest fraction of an inch as a power of two (3 is 1/8\").",
          "default": 0
        }
      },
      "required": ["length"],
      "additionalProperties": false
    },
    "DisplayLength": {
      "type": "string",
      "description": "How lengths are shown.",
      "enum": ["mm", "cm", "m", "ft-in", "ft", "in"]
    },
    "Material": {
      "type": "object",
      "description": "What elements are made of: their colour in 3D and the hatch on their cut faces. Start from a library material by its name, or give the values yourself; any value given overrides the library's.",
      "properties": {
        "id": { "type": "string" },
        "name": {
          "type": "string",
          "description": "Shown in the app; the id when left out."
        },
        "library": {
          "type": "string",
          "description": "A material of CreaBIM's library, by name (\"Concrete, cast in place\"), to start from."
        },
        "hatch": { "$ref": "#/$defs/Hatch" },
        "colour": {
          "oneOf": [
            { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0, "maximum": 1 },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        },
        "category": {
          "type": "string",
          "description": "IFC's material category: concrete, brick, wood, steel, glass..."
        },
        "description": { "type": "string" },
        "roughness": { "type": "number", "description": "0 mirror-smooth to 1 fully matte." },
        "metallic": {
          "type": "number",
          "description": "0 for almost everything, 1 for bare metal."
        },
        "opacity": { "type": "number", "description": "1 opaque; glass is about 0.3." },
        "rate": {
          "type": "number",
          "description": "Its price for the take-off, in the project's currency, for each `rate_per`."
        },
        "rate_per": {
          "$ref": "#/$defs/RatePer",
          "description": "What `rate` prices: square metres (the default), cubic metres, metres or pieces."
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "Hatch": {
      "type": "string",
      "description": "The pattern on a material's cut faces.",
      "enum": ["empty", "solid", "diagonal", "cross", "brick", "concrete", "timber"]
    },
    "RatePer": {
      "type": "string",
      "description": "What a material's rate is priced per.",
      "enum": ["m2", "m3", "m", "each"]
    },
    "Assembly": {
      "type": "object",
      "description": "A layered build-up. Walls list layers from the exterior face in; floors and roofs from the top down. An element built of one is as thick as its layers.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "usage": { "$ref": "#/$defs/AssemblyUsage", "default": "wall" },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Layer" }
        },
        "description": { "type": "string" }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "AssemblyUsage": {
      "type": "string",
      "description": "What an assembly is for.",
      "enum": ["wall", "floor", "roof"]
    },
    "Layer": {
      "type": "object",
      "description": "One layer of an assembly.",
      "properties": {
        "function": { "$ref": "#/$defs/LayerFunction", "default": "structure" },
        "material": { "type": "string", "description": "A material's id; none for an air gap." },
        "thickness": { "type": "number" },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "description": "Which layer wins where walls join: 1 cuts through 5. Left out, it follows the layer's function (structure 1, finish 5)."
        }
      },
      "required": ["thickness"],
      "additionalProperties": false
    },
    "LayerFunction": {
      "type": "string",
      "description": "What a layer does. The core runs from the first structure layer to the last.",
      "enum": ["structure", "substrate", "insulation", "air-gap", "membrane", "finish"]
    },
    "Type": {
      "type": "object",
      "description": "An element type: shared values its instances take, so editing the type in the app changes them all. An instance names it in its `type` field and may still set any of those values itself.\n\nWhich fields a category uses: wall: `thickness` (or `assembly`), `material`, `location`, `height`, `screen`; door and window: `width`, `height`, `sill`, `frame`, `material`; slab and roof: `thickness` (or `assembly`), `material`; column: `width` and `depth`, or `diameter`, and `material`; beam: `width`, `depth`, `material`.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "$ref": "#/$defs/TypeCategory" },
        "description": { "type": "string" },
        "thickness": { "type": "number" },
        "assembly": { "type": "string", "description": "An assembly's id." },
        "material": { "type": "string", "description": "A material's id." },
        "location": {
          "$ref": "#/$defs/Location",
          "description": "A wall type's location line."
        },
        "boundary": {
          "type": "integer",
          "minimum": 0,
          "description": "With location `layer-boundary`: which boundary, counted from the exterior face (0) to the interior face (the layer count)."
        },
        "height": {
          "type": "number",
          "description": "A wall type's height for new walls; a door or window's height."
        },
        "width": { "type": "number" },
        "sill": { "type": "number" },
        "frame": { "$ref": "#/$defs/Frame" },
        "depth": { "type": "number" },
        "diameter": { "type": "number" },
        "screen": {
          "$ref": "#/$defs/Screen",
          "description": "Makes a wall type a screen wall: a repeating unit with holes."
        }
      },
      "required": ["id", "category"],
      "additionalProperties": false
    },
    "TypeCategory": {
      "type": "string",
      "description": "What a type is for.",
      "enum": ["wall", "door", "window", "slab", "roof", "column", "beam"]
    },
    "Location": {
      "type": "string",
      "description": "The line a wall is drawn along and kept on when it gets thicker. The exterior is on the wall's right, looking from start to end, unless the wall is flipped.",
      "enum": [
        "centre",
        "core-centre",
        "exterior-face",
        "interior-face",
        "core-exterior",
        "core-interior",
        "layer-boundary"
      ]
    },
    "Frame": {
      "type": "object",
      "description": "How a door or window is built inside its opening.",
      "properties": {
        "width": {
          "type": "number",
          "description": "Face width of the frame members.",
          "default": 0.06
        },
        "depth": {
          "type": "number",
          "description": "Depth of the frame through the wall.",
          "default": 0.1
        },
        "panes_across": {
          "type": "integer",
          "minimum": 0,
          "description": "Window panes side by side.",
          "default": 1
        },
        "panes_up": {
          "type": "integer",
          "minimum": 0,
          "description": "Window panes one above the other.",
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "Screen": {
      "type": "object",
      "description": "The repeating unit of a screen wall (breeze block, louvres, lattice).",
      "properties": {
        "unit": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "The unit's size, joints included: along the wall and up."
        },
        "holes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Rect" },
          "description": "The open rectangles of one unit, from its lower left corner."
        },
        "frame": {
          "type": "number",
          "description": "A solid border this wide round the screen.",
          "default": 0.0
        },
        "stagger": {
          "type": "boolean",
          "description": "Every other course shifted half a unit along.",
          "default": false
        }
      },
      "required": ["unit"],
      "additionalProperties": false
    },
    "Rect": {
      "type": "object",
      "description": "A rectangle by its lower left and upper right corners.",
      "properties": {
        "min": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "max": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "Level": {
      "type": "object",
      "description": "A storey. Elements hang off a level, so moving it moves them.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "elevation": {
          "type": "number",
          "description": "Height of its floor above the project's zero."
        },
        "height": {
          "type": "number",
          "description": "Floor-to-floor height: the height walls on it take unless told otherwise.",
          "default": 3.0
        }
      },
      "required": ["id", "elevation"],
      "additionalProperties": false
    },
    "GridGroup": {
      "type": "object",
      "description": "A grid system: how its lines are labelled and coloured.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "prefix": {
          "type": "string",
          "description": "Put before every label: \"A-\" gives A-1, A-2...",
          "default": ""
        },
        "vertical": {
          "$ref": "#/$defs/GridLabels",
          "description": "How lines running north-south are labelled, west to east.",
          "default": "letters"
        },
        "horizontal": {
          "$ref": "#/$defs/GridLabels",
          "description": "How lines running east-west are labelled, south to north.",
          "default": "numbers"
        },
        "colour": {
          "oneOf": [
            { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0, "maximum": 1 },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "GridLabels": {
      "type": "string",
      "description": "Grid labels.",
      "enum": ["numbers", "letters"]
    },
    "Grid": {
      "type": "object",
      "description": "A grid line.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "label": {
          "type": "string",
          "description": "Its label after its group's prefix; the id when left out."
        },
        "start": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "group": { "type": "string", "description": "A grid group's id." }
      },
      "required": ["id", "start", "end"],
      "additionalProperties": false
    },
    "Wall": {
      "type": "object",
      "description": "A straight wall along its centreline on a level.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mark": {
          "type": "string",
          "description": "Its mark, shown by tags and schedules; none numbers it automatically."
        },
        "level": { "type": "string", "description": "A level's id." },
        "start": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "type": {
          "type": "string",
          "description": "A wall type's id: the wall takes its thickness, assembly, material, location line and height."
        },
        "thickness": {
          "type": "number",
          "description": "Needed unless the wall has a type or an assembly."
        },
        "height": {
          "type": "number",
          "description": "Height above its base. Left out: up to `top_level` when given, else the type's height, else its level's height."
        },
        "base_offset": {
          "type": "number",
          "description": "Its base above its level.",
          "default": 0.0
        },
        "top_level": {
          "type": "string",
          "description": "A level's id: the top stays `top_offset` above that level as levels move."
        },
        "top_offset": { "type": "number", "default": 0.0 },
        "material": { "type": "string" },
        "assembly": { "type": "string" },
        "location": { "$ref": "#/$defs/Location" },
        "boundary": {
          "type": "integer",
          "minimum": 0,
          "description": "With location `layer-boundary`: which boundary, counted from the exterior face (0) to the interior face (the layer count)."
        },
        "flip": {
          "type": "boolean",
          "description": "The exterior face on the left instead of the right.",
          "default": false
        },
        "attach_top": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Roofs and slabs (ids) the top follows the underside of."
        }
      },
      "required": ["id", "level", "start", "end"],
      "additionalProperties": false
    },
    "Opening": {
      "type": "object",
      "description": "A door, window or bare hole in a wall, placed by its distance along the wall from the wall's start.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mark": { "type": "string" },
        "kind": { "$ref": "#/$defs/OpeningKind" },
        "wall": { "type": "string", "description": "The host wall's id." },
        "offset": {
          "type": "number",
          "description": "From the wall's start to the opening's near edge. Give this or `centre`."
        },
        "centre": {
          "type": "number",
          "description": "From the wall's start to the opening's middle."
        },
        "type": {
          "type": "string",
          "description": "A door or window type's id: the opening takes its width, height, sill, frame and material."
        },
        "width": { "type": "number", "description": "Needed unless the opening has a type." },
        "height": { "type": "number", "description": "Needed unless the opening has a type." },
        "sill": {
          "type": "number",
          "description": "Its bottom above the wall's base. Left out: 0 for doors and holes, 0.9 m for windows (or the type's)."
        },
        "material": { "type": "string" },
        "frame": { "$ref": "#/$defs/Frame" },
        "flip_hand": {
          "type": "boolean",
          "description": "A door hinged on the jamb at the wall's end side.",
          "default": false
        },
        "flip_facing": {
          "type": "boolean",
          "description": "A door opening to the wall's exterior; a window facing its interior.",
          "default": false
        }
      },
      "required": ["id", "kind", "wall"],
      "additionalProperties": false
    },
    "OpeningKind": {
      "type": "string",
      "description": "What an opening is.",
      "enum": ["door", "window", "hole"]
    },
    "Slab": {
      "type": "object",
      "description": "A floor slab: its outline pushed down from its top face.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "outline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "The corners in plan, either way round."
        },
        "bulges": {
          "type": "array",
          "items": { "type": "number" },
          "description": "How each edge bends (corner i to i + 1): the tangent of a quarter of the arc's angle, positive bulging left. 0 or left out is straight."
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "description": "Holes through it, each an outline inside it."
        },
        "thickness": {
          "type": "number",
          "description": "Needed unless the slab has a type or an assembly."
        },
        "top_offset": {
          "type": "number",
          "description": "Its top face above its level; negative for below.",
          "default": 0.0
        },
        "type": { "type": "string" },
        "material": { "type": "string" },
        "assembly": { "type": "string" }
      },
      "required": ["id", "level"],
      "additionalProperties": false
    },
    "Roof": {
      "type": "object",
      "description": "A roof over a wall-plate outline.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "outline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Where the slopes start, in plan."
        },
        "shape": { "$ref": "#/$defs/RoofShape", "default": "hip" },
        "pitch": {
          "type": "number",
          "description": "Slope in degrees. Needed unless the roof is flat."
        },
        "overhang": {
          "type": "number",
          "description": "How far it reaches past the outline, in plan.",
          "default": 0.0
        },
        "thickness": {
          "type": "number",
          "description": "Square to the slope. Needed unless the roof has a type or an assembly."
        },
        "base_offset": { "type": "number", "default": 0.0 },
        "edge": {
          "type": "integer",
          "minimum": 0,
          "description": "The outline edge a shed roof rises from, or a gable roof's ridge runs along (edge i runs from corner i to i + 1).",
          "default": 0
        },
        "type": { "type": "string" },
        "material": { "type": "string" },
        "assembly": { "type": "string" },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "description": "Holes cut upright through it (roof lights, a chimney)."
        }
      },
      "required": ["id", "level"],
      "additionalProperties": false
    },
    "RoofShape": {
      "type": "string",
      "description": "A roof's shape.",
      "enum": ["flat", "shed", "gable", "hip"]
    },
    "Column": {
      "type": "object",
      "description": "A column: a rectangular (`width` × `depth`) or round (`diameter`) profile standing on a level.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mark": { "type": "string" },
        "level": { "type": "string" },
        "at": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "The profile's centre in plan."
        },
        "type": { "type": "string" },
        "width": { "type": "number" },
        "depth": { "type": "number" },
        "diameter": { "type": "number" },
        "rotation": {
          "type": "number",
          "description": "Turn of the profile, degrees anticlockwise.",
          "default": 0.0
        },
        "base_offset": { "type": "number", "default": 0.0 },
        "height": {
          "type": "number",
          "description": "A fixed height. Left out: up to `top_level`, else to the next level up."
        },
        "top_level": { "type": "string" },
        "top_offset": { "type": "number", "default": 0.0 },
        "material": { "type": "string" }
      },
      "required": ["id", "level", "at"],
      "additionalProperties": false
    },
    "Beam": {
      "type": "object",
      "description": "A beam, its top `top_offset` below the top of its storey.",
